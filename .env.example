# ==============================================================================
# PERSONAL BET — ENVIRONMENT CONFIGURATION TEMPLATE (.env)
# ==============================================================================
# Store private API keys here. Never commit production keys to public repositories.

# 1. API-Football (v3) — https://dashboard.api-football.com/
# Contributes: Lineups, player stats, injuries, fixture coverage
API_FOOTBALL_KEY=your_api_football_key_here

# 2. The Odds API (v4) — https://the-odds-api.com/
# Contributes: Live multi-bookmaker odds (1X2, Spreads, Totals)
THE_ODDS_API_KEY=0b2ddfc8ded47a917c64f6b5b36c0cd7

# 3. football-data.org (v4) — https://www.football-data.org/
# Contributes: European competition schedules, standings, match results
FOOTBALL_DATA_ORG_KEY=5927ac0ce29e40748c8efca8cacf0f60

# 4. Telegram Bot API — https://core.telegram.org/bots
# Contributes: Authorized channel tipster ingestion and message poller
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHANNEL_IDS=@channel1,@channel2

# 5. Database & System Settings
DATABASE_URL=sqlite:///personal_bet.db
APP_ENV=production
